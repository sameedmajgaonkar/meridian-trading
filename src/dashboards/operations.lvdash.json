{
  "datasets": [
    {
      "name": "job_runs",
      "displayName": "Job Runs",
      "queryLines": [
        "SELECT * FROM job_runs ORDER BY started_at DESC"
      ]
    },
    {
      "name": "latest_run",
      "displayName": "Latest Run",
      "queryLines": [
        "SELECT run_id,environment,started_at,result_state,duration_seconds FROM job_runs ORDER BY started_at DESC LIMIT 1"
      ]
    },
    {
      "name": "task_runs",
      "displayName": "Task Runs",
      "queryLines": [
        "SELECT task_key,avg(duration_seconds) AS average_seconds,sum(duration_seconds) AS total_seconds FROM task_runs GROUP BY task_key ORDER BY total_seconds DESC"
      ]
    },
    {
      "name": "pipeline_updates",
      "displayName": "Pipeline Updates",
      "queryLines": [
        "SELECT * FROM pipeline_updates ORDER BY started_at DESC"
      ]
    },
    {
      "name": "expectations",
      "displayName": "Expectations",
      "queryLines": [
        "SELECT * FROM expectations ORDER BY recorded_at DESC"
      ]
    },
    {
      "name": "quality_gate",
      "displayName": "Quality Gate",
      "queryLines": [
        "SELECT checked_on,batch,check_name,status,value,detail,run_id FROM quality_gate ORDER BY checked_on DESC,check_name"
      ]
    },
    {
      "name": "quarantine",
      "displayName": "Quarantine",
      "queryLines": [
        "SELECT _batch_id,entity,stage,count(*) AS rejected_records FROM quarantine_records GROUP BY _batch_id,entity,stage ORDER BY _batch_id,entity,stage"
      ]
    },
    {
      "name": "compute_usage",
      "displayName": "Compute Usage",
      "queryLines": [
        "SELECT * FROM compute_usage WHERE usage_unit='DBU' ORDER BY usage_date"
      ]
    },
    {
      "name": "query_performance",
      "displayName": "Query Performance",
      "queryLines": [
        "SELECT statement_id,start_time,execution_status,total_duration_ms,read_rows,produced_rows FROM query_performance ORDER BY total_duration_ms DESC LIMIT 20"
      ]
    },
    {
      "name": "gold_lineage",
      "displayName": "Gold Lineage",
      "queryLines": [
        "SELECT * FROM gold_lineage ORDER BY event_date DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "health",
