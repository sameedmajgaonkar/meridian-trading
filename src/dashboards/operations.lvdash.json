        {
          "widget": {
            "name": "run_durations",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "job_runs",
                  "fields": [
                    {
                      "name": "started_at",
                      "expression": "`started_at`"
                    },
                    {
                      "name": "seconds",
                      "expression": "SUM(`duration_seconds`)"
