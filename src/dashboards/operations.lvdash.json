          "position": {
            "x": 0,
            "y": 1,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "latest",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "latest_run",
                  "fields": [
                    {
                      "name": "run_id",
                      "expression": "`run_id`"
                    },
                    {
                      "name": "environment",
                      "expression": "`environment`"
                    },
                    {
                      "name": "started_at",
                      "expression": "`started_at`"
                    },
                    {
                      "name": "result_state",
                      "expression": "`result_state`"
                    },
                    {
                      "name": "duration_seconds",
                      "expression": "`duration_seconds`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "run_id",
                    "displayName": "Run Id"
                  },
                  {
                    "fieldName": "environment",
                    "displayName": "Environment"
                  },
                  {
                    "fieldName": "started_at",
                    "displayName": "Started At"
                  },
                  {
                    "fieldName": "result_state",
                    "displayName": "Result State"
                  },
                  {
                    "fieldName": "duration_seconds",
                    "displayName": "Duration Seconds"
