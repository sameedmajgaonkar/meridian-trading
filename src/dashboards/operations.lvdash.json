                "y": {
                  "fieldName": "seconds",
                  "scale": {
                    "type": "quantitative"
                  },
                  "format": {
                    "type": "number-plain",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    }
                  }
                },
                "color": {
                  "fieldName": "result_state",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "frame": {
                "showTitle": true,
