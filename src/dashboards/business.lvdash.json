            "name": "definitions",
            "multilineTextboxSpec": {
              "lines": [
                "**Definitions:** Net revenue = extended price \u00d7 (1 \u2212 discount), excluding tax. Orders count headers once, including headers with no retained lines. AOV = net revenue / headers. Delivery days = receipt \u2212 ship, averaged over valid lines. Late = receipt > commit. Return rate = R lines / all valid lines. Discount given = extended price \u00d7 discount. Empty rates show NULL, not an invented zero."
              ]
            }
