{
  "datasets": [
    {
      "name": "trading",
      "displayName": "Governed trading KPIs",
      "asset_name": "mv_trading"
    },
    {
      "name": "order_detail",
      "displayName": "Order Detail",
      "queryLines": [
        "SELECT order_key,order_date,region_name,nation_name,market_segment_at_order_time,order_status,order_total_price FROM fct_order_headers WHERE order_date BETWEEN :report_window.min AND :report_window.max ORDER BY order_date DESC,order_key"
      ],
      "parameters": [
        {
          "keyword": "report_window",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "1995-01-01"
              },
              "max": {
                "value": "1995-12-31"
              }
            }
          },
          "displayName": "Order dates"
        }
      ]
    },
    {
      "name": "customer_access",
      "displayName": "Customer Access",
      "queryLines": [
        "SELECT customer_key,region_name,nation_name,customer_phone,customer_account_balance FROM dim_customer_history WHERE is_current=true ORDER BY customer_key LIMIT 20"
      ]
    }
  ],
